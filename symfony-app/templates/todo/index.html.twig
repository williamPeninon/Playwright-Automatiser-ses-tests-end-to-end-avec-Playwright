<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ma Todo List - Formation Playwright</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 640px; margin: 40px auto; padding: 0 16px; color: #222; }
        h1 { color: #1E2761; }
        form.add-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; margin-bottom: 16px; }
        .field { display: flex; flex-direction: column; gap: 4px; font-size: 14px; }
        .field.grow { flex: 1; }
        input[type="text"], select { padding: 8px; font-size: 16px; }
        button { padding: 8px 14px; font-size: 15px; cursor: pointer; }
        nav.filters { display: flex; gap: 12px; margin: 8px 0 16px; }
        nav.filters a[aria-current="page"] { font-weight: bold; text-decoration: none; color: #1E2761; }
        ul { list-style: none; padding: 0; }
        li { display: flex; gap: 8px; align-items: center; padding: 10px; border-bottom: 1px solid #eee; }
        li .todo-label { flex: 1; }
        .is-done { text-decoration: line-through; color: #888; }
        .badge { font-size: 12px; padding: 2px 8px; border-radius: 10px; background: #eef; }
        .badge.haute { background: #fdd; }
        .toast { background: #e6f6ee; border: 1px solid #39a36b; padding: 8px 12px; margin-bottom: 16px; }
        .stats { margin-top: 24px; padding: 12px; background: #f5f7fb; }
        footer { display: flex; justify-content: space-between; align-items: center; }
    </style>
</head>
<body>
    <header>
        <h1 data-testid="page-title">Ma Todo List</h1>
        <p>Application Symfony volontairement simple, utilisée comme support pour écrire des tests Playwright.</p>
    </header>

    {# Message "toast" : visible quelques secondes puis supprimé par JavaScript (Jour 1 - éléments dynamiques) #}
    {% for message in app.flashes('success') %}
        <div class="toast" role="status" data-testid="toast">{{ message }}</div>
    {% endfor %}

    <form class="add-form" method="post" action="{{ path('todo_add') }}" data-testid="add-form">
        <div class="field grow">
            <label for="todo-input">Nouvelle tâche</label>
            <input type="text" id="todo-input" name="label" placeholder="Ex. : Réviser les locators" data-testid="todo-input" required>
        </div>
        <div class="field">
            <label for="priority">Priorité</label>
            <select id="priority" name="priority" data-testid="priority-select">
                {% for value, label in priorities %}
                    <option value="{{ value }}" {{ value == 'normale' ? 'selected' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        <button type="submit" data-testid="add-button">Ajouter</button>
    </form>

    <nav class="filters" aria-label="Filtres">
        <a href="{{ path('todo_index') }}" {{ filter == 'all' ? 'aria-current="page"' }} data-testid="filter-all">Toutes</a>
        <a href="{{ path('todo_index', { filter: 'active' }) }}" {{ filter == 'active' ? 'aria-current="page"' }} data-testid="filter-active">Actives</a>
        <a href="{{ path('todo_index', { filter: 'done' }) }}" {{ filter == 'done' ? 'aria-current="page"' }} data-testid="filter-done">Terminées</a>
    </nav>

    <ul data-testid="todo-list" aria-label="Liste des tâches">
        {% for todo in todos %}
            <li data-testid="todo-item" data-completed="{{ todo.done ? 'true' : 'false' }}">
                <span class="todo-label {{ todo.done ? 'is-done' }}" data-testid="todo-label">{{ todo.label }}</span>
                <span class="badge {{ todo.priority }}" data-testid="todo-priority">{{ priorities[todo.priority] }}</span>
                <form method="post" action="{{ path('todo_toggle', { id: todo.id, filter: filter }) }}">
                    <button type="submit" data-testid="toggle-button">{{ todo.done ? 'Réouvrir' : 'Terminer' }}</button>
                </form>
                <form method="post" action="{{ path('todo_delete', { id: todo.id }) }}">
                    <button type="submit" data-testid="delete-button">Supprimer</button>
                </form>
            </li>
        {% else %}
            <li data-testid="empty-state">Aucune tâche pour le moment</li>
        {% endfor %}
    </ul>

    <footer>
        {% set remaining = stats.remaining %}
        <p data-testid="todo-counter">{{ remaining }} {{ remaining > 1 ? 'tâches restantes' : 'tâche restante' }}</p>
        {% if stats.total > 0 %}
            <form method="post" action="{{ path('todo_clear') }}" id="clear-form">
                <button type="submit" data-testid="clear-button">Vider la liste</button>
            </form>
        {% endif %}
    </footer>

    {# Statistiques chargées en AJAX avec un délai serveur aléatoire (0,5 à 2 s) #}
    <section class="stats" aria-label="Statistiques" data-testid="stats">
        <p data-testid="stats-loading">Chargement des statistiques…</p>
    </section>

    <script>
        // 1. Le toast disparaît après 3 secondes.
        document.querySelectorAll('[data-testid="toast"]').forEach((toast) => {
            setTimeout(() => toast.remove(), 3000);
        });

        // 2. Demande de confirmation avant de vider la liste (boîte de dialogue native).
        const clearForm = document.getElementById('clear-form');
        if (clearForm) {
            clearForm.addEventListener('submit', (event) => {
                if (!confirm('Supprimer toutes les tâches ?')) {
                    event.preventDefault();
                }
            });
        }

        // 3. Chargement asynchrone des statistiques.
        const stats = document.querySelector('[data-testid="stats"]');
        fetch('{{ path('api_stats') }}')
            .then((response) => {
                if (!response.ok) { throw new Error('HTTP ' + response.status); }
                return response.json();
            })
            .then((data) => {
                stats.innerHTML =
                    '<p data-testid="stats-content">Total : <strong data-testid="stats-total">' + data.total + '</strong>'
                    + ' · Terminées : <strong data-testid="stats-done">' + data.done + '</strong></p>';
            })
            .catch(() => {
                stats.innerHTML = '<p role="alert" data-testid="stats-error">Statistiques indisponibles</p>';
            });
    </script>
</body>
</html>
