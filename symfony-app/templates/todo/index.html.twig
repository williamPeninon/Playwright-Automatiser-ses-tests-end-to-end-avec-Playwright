<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ma Todo List - Formation Symfony &amp; Playwright</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 40px auto; color: #222; }
        h1 { color: #1E2761; }
        form.add-form { display: flex; gap: 8px; margin-bottom: 24px; }
        input[type="text"] { flex: 1; padding: 8px; font-size: 16px; }
        button { padding: 8px 16px; font-size: 16px; cursor: pointer; }
        ul { list-style: none; padding: 0; }
        li { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-bottom: 1px solid #eee; }
    </style>
</head>
<body>
    <h1 data-testid="page-title">Ma Todo List</h1>
    <p>Petite application Symfony volontairement simple, utilisée comme support pour écrire des tests Playwright....</p>

    <form class="add-form" method="post" action="{{ path('todo_add') }}" data-testid="add-form">
        <input type="text" name="label" placeholder="Nouvelle tâche" data-testid="todo-input" required>
        <button type="submit" data-testid="add-button">Ajouter</button>
    </form>

    <ul data-testid="todo-list">
        {% for todo in todos %}
            <li data-testid="todo-item">
                <span data-testid="todo-label">{{ todo.label }}</span>
                <form method="post" action="{{ path('todo_delete', { id: todo.id }) }}">
                    <button type="submit" data-testid="delete-button">Supprimer</button>
                </form>
            </li>
        {% else %}
            <li data-testid="empty-state">Aucune tâche pour le moment</li>
        {% endfor %}
    </ul>
</body>
</html>
